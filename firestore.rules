rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions (수정 없음) =====
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUserAdmin() {
      let adminUids = ['Xfzi3IEX5LXA13wbyJYxjftmJ9p2', 'y1C8XaVM1EZkt2zjMHsykQFYlRM2'];
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.uid in adminUids);
    }
    function isNotAnonymous() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // =============================================================
    // [추가] 새로운 아키텍처를 위한 규칙
    // =============================================================
    match /base_parts/{basePartId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /base_part_prices/{basePartId}/{document=**} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    // =============================================================
    // [수정] 마이그레이션을 위해 필요한 최소한의 수정
    // =============================================================
    match /parts/{partId} {
      allow read: if true;
      // [수정] 기존 if false; 에서 마이그레이션 스크립트 실행을 위해 isUserAdmin()으로 변경
      allow write: if isUserAdmin();
    }

    // =============================================================
    // [원상 복구] 요청하신 대로 전혀 수정하지 않은 기존 규칙들
    // =============================================================

    // ===== Users Collection (수정 없음) =====
    match /users/{userId} {
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['isAdmin']);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && !request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasAny(['isAdmin']);
      allow delete: if isAuthenticated()
                    && (request.auth.uid == userId || isUserAdmin());
    }

    // ===== Sell Requests Collection (수정 없음) =====
    function isValidSellRequest() {
      let data = request.resource.data;
      let required = ['partId','sellerId','brand','modelName',
                      'purchaseDate','requestedPrice','imageUrls','status'];
      return data.keys().hasAll(required)
             && data.partId is string && data.partId.size() > 0
             && data.sellerId == request.auth.uid
             && data.requestedPrice is number && data.requestedPrice > 0
             && data.imageUrls is list
             && data.imageUrls.size() > 0 && data.imageUrls.size() <= 10;
    }
    match /sell_requests/{requestId} {
      allow create: if isAuthenticated() && isNotAnonymous()
                    && request.auth.uid == request.resource.data.sellerId
                    && isValidSellRequest();
      allow update: if isAuthenticated() && (
                      (isNotAnonymous() && request.auth.uid == resource.data.sellerId) ||
                      (isUserAdmin() && request.resource.data.keys().hasAny(['status', 'finalPrice', 'finalConditionScore', 'processedAt']))
                    );
      allow delete: if isAuthenticated() && isNotAnonymous()
                            && request.auth.uid == resource.data.sellerId;
      allow read: if isAuthenticated();
    }

    // ===== Carts Collection (수정 없음) =====
    match /carts/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ===== Listings Collection (최소한의 수정) =====
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.sellerId
         && resource.data.status == 'available')
        ||
        (resource.data.status == 'available'
         && request.resource.data.status == 'sold'
         && request.resource.data.buyerId == request.auth.uid
         && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['status','buyerId','soldAt']))
      );
      allow delete: if isAuthenticated()
                    && request.auth.uid == resource.data.sellerId
                    && resource.data.status == 'available';
    }

    // ===== Orders Collection (수정 없음) =====
    function hasItems(doc) {
      return doc.keys().hasAny(['items']) && doc.items is list && doc.items.size() > 0;
    }
    function firstItemSellerId(doc) {
      return hasItems(doc) ? doc.items[0].sellerId : '';
    }
    match /orders/{orderId} {
      allow create: if isAuthenticated()
                    && request.resource.data.buyerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == firstItemSellerId(resource.data)
      );
      allow update: if isAuthenticated()
                    && request.auth.uid == firstItemSellerId(resource.data);
      allow delete: if false;
    }

    // ===== Posts Collection (수정 없음) =====
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if isAuthenticated()
                            && request.auth.uid == resource.data.authorId;
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isUserAdmin()
                      && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAuthenticated()
                              && request.auth.uid == resource.data.userId;
      }
    }
  }
}